CLIENT_API_TOKEN=replace-with-a-random-client-token-at-least-32-characters
KASEKI_SUBMISSION_API_TOKEN=replace-with-a-distinct-kaseki-submission-token-at-least-32-characters
WORKER_API_TOKEN=replace-with-a-different-random-worker-token-at-least-32-characters
SOYUZ_ENVIRONMENT=development
SOYUZ_PUBLIC_URL=http://127.0.0.1:8787
# Set this to the same local-only token configured for the Soyuz identity in Senku.
SENKU_SOYUZ_API_TOKEN=replace-with-a-different-long-random-local-token
