{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cyanautomation.dev/soyuz/persistence/v1/decision-record.schema.json",
  "title": "Soyuz mapping of Senku decision response v1",
  "description": "Maps Senku's immutable schemaVersion 1 response; this does not redefine Senku's decision contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "runId", "decisionSchemaVersion", "profile", "provider", "model", "status", "answers", "createdAt", "expiresAt", "retentionPolicyVersion"],
  "properties": {
    "decisionId": { "type": "string", "format": "uuid" },
    "runId": { "type": ["string", "null"], "format": "uuid" },
    "decisionSchemaVersion": { "const": "1" },
    "profile": { "type": "string", "minLength": 1, "maxLength": 100 },
    "profileVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "provider": { "const": "jev" },
    "model": { "type": "string", "maxLength": 120 },
    "status": { "const": "completed" },
    "answers": { "type": "object", "maxProperties": 64 },
    "evidenceReferences": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 300 } },
    "usage": { "type": "object", "additionalProperties": false, "properties": { "input_tokens": { "type": "integer", "minimum": 0 }, "output_tokens": { "type": "integer", "minimum": 0 }, "total_tokens": { "type": "integer", "minimum": 0 }, "cost": { "type": "number", "minimum": 0 } } },
    "durationMs": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "retentionPolicyVersion": { "const": 1 }
  }
}
