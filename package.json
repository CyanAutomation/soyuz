{
  "name": "@cyanautomation/soyuz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "patch-package",
    "build": "tsc --noEmit -p tsconfig.browser.json && esbuild dashboard/app.ts --bundle --platform=browser --target=es2023 --format=esm --minify --outfile=public/dashboard/app.js",
    "typecheck": "wrangler types && tsc --noEmit && tsc -p tsconfig.browser.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:kaseki": "vitest run tests/kaseki-protocol.test.ts",
    "test:cross-worker": "node --test scripts/senku-cross-worker.test.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "skills:check": "node scripts/validate-skill-references.mjs",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply soyuz-runs --local",
    "db:migrate:remote": "wrangler d1 migrations apply soyuz-runs --remote",
    "soyuz:smoke": "node scripts/soyuz-production-smoke.ts"
  },
  "dependencies": {
    "@a2ui/web_core": "0.15.0",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@types/node": "^26.6.6",
    "@utcp/http": "^1.1.14",
    "@utcp/sdk": "^1.2.0",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.15",
    "patch-package": "8.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "@a2ui/web_core": {
      "zod": "$zod"
    }
  }
}
