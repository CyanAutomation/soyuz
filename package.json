{
  "name": "@cyanautomation/soyuz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "build": "tsc -p tsconfig.dashboard.build.json && esbuild dashboard/analysis/app.ts --bundle --platform=browser --target=es2022 --format=esm --minify --outfile=public/dashboard/analysis/app.js",
    "typecheck": "wrangler types && tsc --noEmit && tsc -p tsconfig.browser.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:kaseki": "vitest run tests/kaseki-protocol.test.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply soyuz-runs --local",
    "db:migrate:remote": "wrangler d1 migrations apply soyuz-runs --remote",
    "soyuz:smoke": "node scripts/soyuz-production-smoke.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "@openuidev/lang-core": "^1.0.1",
    "agents": "^0.28.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "qs": "^6.16.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  }
}
