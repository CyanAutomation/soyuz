{
  "name": "@cyanautomation/soyuz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:mutation:unit": "wrangler types && stryker run stryker.unit.config.mjs",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply soyuz-runs --local",
    "db:migrate:remote": "wrangler d1 migrations apply soyuz-runs --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.26.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
