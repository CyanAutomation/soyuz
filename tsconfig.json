{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": ["@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "worker-configuration.d.ts", "vitest.config.ts", "vitest.unit.config.ts"],
  "exclude": [
    "tests/openui.test.ts",
    "tests/dashboard-api.test.ts",
    "tests/migration-impact.test.ts",
    "tests/soyuz-production-smoke.test.ts",
    "tests/migration-history.test.ts",
    "tests/verify-production-database.test.ts"
  ]
}
