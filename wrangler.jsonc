{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soyuz",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "SOYUZ_PUBLIC_URL": "https://soyuz.scheimann.workers.dev",
    "SOYUZ_OAUTH_ALLOWED_GITHUB_IDS": "68898852"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "bbaeb9b98b8746818193a5eac9e69f88"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soyuz-runs",
      "database_id": "85d91f72-d76c-409b-a60c-6bb7b27a3f0b",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "RUN_QUEUE", "queue": "soyuz-runs" }
    ]
  },
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "soyuz-artifacts" }
  ],
  "triggers": {
    "crons": ["*/1 * * * *", "0 3 * * *"]
  },
  "secrets": {
    "required": ["CLIENT_API_TOKEN", "WORKER_API_TOKEN"]
  }
}
