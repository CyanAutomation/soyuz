{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soyuz",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soyuz-runs",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "RUN_QUEUE", "queue": "soyuz-runs" }
    ]
  },
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "secrets": {
    "required": ["CLIENT_API_TOKEN", "WORKER_API_TOKEN"]
  }
}
